{
  "manifest_version": 3,
  "name": "Vampetase 2.0",
  "short_name": "Vampetase",
  "version": "2.1.0",
  "description": "Vampetiza as imagens das páginas. Agora com controle, fotos locais e suporte ao Chrome moderno.",
  "homepage_url": "https://github.com/famoraes/vampetase",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vampetase 2.0",
    "default_popup": "popup.html",
    "default_icon": "icons/icon19.png"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*.jpg", "images/*.jpeg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
